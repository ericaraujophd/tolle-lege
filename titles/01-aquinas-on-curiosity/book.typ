// book.typ -- the INTERIOR of No. 01, Aquinas, On Curiosity.
// All layout lives in the shared template; this file only says what goes in
// and in which order. Build it with the top-level build.py, which compiles
// with the repository as Typst's root (so "/tools/..." resolves).
#import "/tools/templates/booklet.typ": *
#let meta = toml("title.toml")
#show: book.with(meta)

#title-page(meta)                // page 1
#edition-note(meta)              // page 2
#pagebreak()
#include "intro.typ"              // About this booklet; How to read an article

// The text. content.typ is generated by extract.py and calls #question and
// #article. A plain #include would not see those two functions (Typst
// includes are isolated), so we read the file and evaluate it with them in
// scope.
#eval(read("content.typ"), mode: "markup",
      scope: (question: question, article: article))

#include "reflection.typ"         // Questions for reflection; glossary
#notes(meta)                     // ruled notes pages, colophon on the last
