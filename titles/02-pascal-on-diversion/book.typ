// book.typ -- the INTERIOR of No. 02, Pascal, On Diversion.
// All layout lives in the shared template (tools/templates/booklet.typ);
// this file only says what goes in, and in which order.
#import "/tools/templates/booklet.typ": *
#let meta = toml("title.toml")
#show: book.with(meta)

#title-page(meta)                // page 1
#edition-note(meta)              // page 2
#pagebreak()
#include "intro.typ"              // About this booklet; How to read the fragments

// The text. content.typ is generated by extract.py and calls #chapter (one
// per part) and #section (one per fragment). Typst includes are isolated,
// so we read the file and evaluate it with those two functions in scope.
#eval(read("content.typ"), mode: "markup",
      scope: (chapter: chapter, section: section))

#include "reflection.typ"         // Questions for reflection; glossary
#notes(meta)                     // ruled notes pages, colophon on the last
