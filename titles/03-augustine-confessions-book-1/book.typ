// book.typ -- the INTERIOR. All layout lives in tools/templates/booklet.typ;
// this file only says what goes in, and in which order.
#import "/tools/templates/booklet.typ": *
#let meta = toml("title.toml")
#show: book.with(meta)

#title-page(meta)                // page 1
#edition-note(meta)              // page 2
#pagebreak()
#include "intro.typ"              // About this booklet; How to read it

// The text, generated by extract.py. Typst includes are isolated, so we read
// the file and evaluate it with the helpers it uses in scope.
#eval(read("content.typ"), mode: "markup",
      scope: (chapter: chapter, section: section, summary: summary,
              ref: ref, pnum: pnum))

#endnotes(include "notes.typ")   // Outler's explanatory notes
#include "reflection.typ"         // Questions for reflection
#notes(meta)                     // ruled notes pages, colophon on the last
